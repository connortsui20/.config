{
  // Convenience setting if I want to temporarily disable the servers.
  // "enable_language_server": false,

  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "ssh_connections": [
    {
      "host": "ec2-13-58-212-103.us-east-2.compute.amazonaws.com",
      "username": "ubuntu",
      "args": [],
      "projects": [
        {
          "paths": ["/home/ubuntu"],
        },
        {
          "paths": ["/home/ubuntu/ClickBench"],
        },
      ],
    },
  ],
  "vim_mode": false,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "ui_font_family": "Noto Sans Mono",
  "buffer_font_size": 14,
  "buffer_font_family": "Noto Sans Mono",
  "theme": {
    "mode": "dark",
    "light": "GitLab Light",
    "dark": "Tokyo Night (Custom)",
  },
  "wrap_guides": [100],
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
    "activate_on_close": "left_neighbour",
  },
  "terminal": {
    "dock": "right",
    "font_size": 14,
    "font_family": "Noto Sans Mono",
    "line_height": "comfortable",
    "cursor_shape": "bar",
    "copy_on_select": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "restore_on_startup": "last_workspace",
  "when_closing_with_no_tabs": "keep_window_open",
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 1000,
    },
  },
  "file_scan_exclusions": [
    // "**/.git",
    "**/.svn",
    "**/.hg",
    // "**/.jj",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
  "file_scan_inclusions": [".env*", "**/.git", ".gitignore"],
  "inlay_hints": {
    "enabled": false,
    "show_background": true,
  },
  "agent": {
    "notify_when_agent_waiting": "all_screens",
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
    },
    "model_parameters": [],
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-opus-4-6",
    },
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
  },
  "languages": {
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
    "Markdown": {
      "preferred_line_length": 100,
      "soft_wrap": "preferred_line_length",
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": [
            "--prose-wrap",
            "always",
            "--print-width",
            "100",
            "--stdin-filepath",
            "{buffer_path}",
          ],
        },
      },
      "format_on_save": "on",
    },
  },
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path": "/Users/connor/.cargo/bin/rust-analyzer",
        "arguments": [],
      },
      "initialization_options": {
        "cargo": {
          "targetDir": true,
        },
        "check": {
          "command": "clippy",
        },
        "rustfmt": {
          "extraArgs": ["+nightly"],
        },
        "procMacro": {
          "enable": true,
        },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
          "closureCaptureHints": {
            "enable": true,
          },
        },
      },
    },
  },
}
