[user]
    name = Connor Tsui
    email = connor.tsui20@gmail.com
[init]
    defaultBranch = main
[core]
    editor = hx
    excludesFile = "~/.config/git/.gitignore"
    autocrlf = input
    fsmonitor = true
    untrackedCache = true
    pager = delta
[pull]
    rebase = true
[fetch]
    prune = true
    pruneTags = true
    all = true
    recurseSubmodules = false
[push]
    autoSetupRemote = true
    followTags = true
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[merge]
    conflictStyle = zdiff3
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[commit]
    verbose = true
    gpgsign = true
[ui "color"]
    ui = always
[color]
    ui = true
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[advice]
    addIgnoredFile = false
[help]
    autocorrect = prompt
[alias]
    # Print the name of the default branch on origin (e.g. "main", "master"), by reading
    # origin/HEAD and stripping the origin/ prefix. A fresh clone may have no origin/HEAD at all,
    # in which case ask the remote for it once rather than failing every alias built on this one.
    default-branch = "!f() { \
        REF=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); \
        if [ -z \"$REF\" ]; then \
            git remote set-head origin --auto >/dev/null 2>&1; \
            REF=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); \
        fi; \
        if [ -z \"$REF\" ]; then \
            echo 'origin/HEAD is unset and could not be resolved' >&2; \
            return 1; \
        fi; \
        echo \"${REF#origin/}\"; \
    };f "

    # Find the commit where the given branch (or HEAD if none given) last diverged from
    # origin/<default-branch>. This is the base of your stack.
    merge-base-origin = "!f() { \
        git merge-base ${1-HEAD} origin/$(git default-branch); \
    };f "

    # List every local branch sitting on top of the merge-base, ordered from HEAD down to the
    # oldest, since git log is reverse-chronological. Useful for stacked-branch workflows: prints
    # the names of the branches that make up the current stack.
    #
    # --simplify-by-decoration keeps commits referenced by any ref, while --decorate-refs limits
    # printing to local branches, so a commit held only by a tag or a remote ref yields an empty
    # line. Those are dropped here so callers never see a blank branch name.
    stack = "!f() { \
        BRANCH=${1-HEAD}; \
        MERGE_BASE=$(git merge-base-origin $BRANCH); \
        git log \
            --decorate-refs=refs/heads \
            --simplify-by-decoration \
            --pretty=format:\"%(decorate:prefix=,suffix=,tag=,separator=%n)\" \
            $MERGE_BASE..$BRANCH \
        | grep -v '^$'; \
    };f "

    # Force-push every branch in the current stack to origin, using --force-with-lease for safety.
    # Extra args are forwarded to each push, e.g. `git push-stack --no-verify`.
    push-stack = "!f() { \
        git stack | xargs -I {} git push --force-with-lease \"$@\" origin {}; \
    };f "

    # Refresh origin, then rebase the current branch onto the latest origin/<default-branch>. The
    # merge-base computation bounds the replay to commits unique to this stack, and the
    # `rebase.updateRefs` setting above is what drags the intermediate branch refs along with it.
    # Without that setting the lower branches in the stack would be left pointing at the abandoned
    # commits, and `git stack` would silently stop listing them.
    rebase-on-default = "!f() { \
        git fetch origin && \
        git rebase \"$@\" $(git merge-base-origin) --onto origin/$(git default-branch); \
    };f "

    # `rebase-on-default` for every worktree at once. Scratch worktrees, meaning the ones whose
    # branch is named after the directory holding them, are rebased unasked; anything else, and
    # anything with uncommitted changes, prompts first. It lives in a script file rather than
    # inline here because it needs per-worktree case analysis and interactive prompts.
    #
    # It also fetches once and pins origin/<default-branch> to a single commit up front, rather
    # than resolving the ref per worktree the way `rebase-on-default` does. Otherwise a push
    # landing partway through the run would leave the worktrees spread across two different tips.
    rod-all = "!\"$HOME\"/.config/bin/git-rod-all"

    c = commit --signoff
    ch = checkout
    b = branch
    ba = branch --all
    a = add
    s = status
    r = rebase
    l = log
    d = diff
    rc = rebase --continue
    ra = rebase --abort
    amd = commit --amend --signoff

    db = default-branch
    mb = merge-base-origin
    ps = push-stack
    rod = rebase-on-default
[gpg]
    format = ssh

# The SSH signing key and the 1Password `op-ssh-sign` program path differ per machine, so they
# live in the gitignored `config.local` (created once per machine from `config.local.example`).
# This include is last, so its values take precedence over anything set above.
[include]
    path = config.local
