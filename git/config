[user]
    name = Connor Tsui
    email = connor.tsui20@gmail.com
[init]
    defaultBranch = main
[core]
    editor = hx
    excludesFile = "~/.config/git/.gitignore"
    autocrlf = input
    fsmonitor = true
    untrackedCache = true
    pager = delta
[pull]
    rebase = true
[fetch]
    prune = true
    pruneTags = true
    all = true
    recurseSubmodules = false
[push]
    autoSetupRemote = true
    followTags = true
[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
[merge]
    conflictStyle = zdiff3
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[commit]
    verbose = true
    gpgsign = true
[ui "color"]
    ui = always
[color]
    ui = true
[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[advice]
    addIgnoredFile = false
[help]
    autocorrect = prompt
[alias]
    # Print the name of the default branch on origin (e.g. "main", "master"), by reading
    # origin/HEAD and stripping the refs/remotes/origin/ prefix.
    default-branch = "!git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'"

    # Find the commit where the given branch (or HEAD if none given) last diverged from
    # origin/<default-branch>. This is the base of your stack.
    merge-base-origin = "!f() { \
        git merge-base ${1-HEAD} origin/$(git default-branch); \
    };f "

    # List every local branch sitting on top of the merge-base, in order from oldest to HEAD.
    # Useful for stacked-branch workflows: prints the ordered names of the branches that make up
    # the current stack.
    stack = "!f() { \
        BRANCH=${1-HEAD}; \
        MERGE_BASE=$(git merge-base-origin $BRANCH); \
        git log \
            --decorate-refs=refs/heads \
            --simplify-by-decoration \
            --pretty=format:\"%(decorate:prefix=,suffix=,tag=,separator=%n)\" \
            $MERGE_BASE..$BRANCH; \
    };f "

    # Force-push every branch in the current stack to origin, using --force-with-lease for safety.
    # Extra args are forwarded to each push, e.g. `git push-stack --no-verify`.
    push-stack = "!f() { \
        git stack | xargs -I {} git push --force-with-lease \"$@\" origin {}; \
    };f "

    # Refresh origin, then rebase the current branch onto the latest origin/<default-branch>. The
    # merge-base computation keeps this safe for stacked branches: only commits unique to this
    # branch are replayed.
    rebase-on-default = "!f() { \
        git fetch origin && \
        git rebase \"$@\" $(git merge-base-origin) --onto origin/$(git default-branch); \
    };f "

    c = commit --signoff
    ch = checkout
    b = branch
    ba = branch --all
    a = add
    s = status
    r = rebase
    l = log
    d = diff
    rc = rebase --continue
    ra = rebase --abort
    amd = commit --amend --signoff

    db = default-branch
    mb = merge-base-origin
    ps = push-stack
    rod = rebase-on-default
[gpg]
    format = ssh

# The SSH signing key and the 1Password `op-ssh-sign` program path differ per machine, so they
# live in the gitignored `config.local` (created once per machine from `config.local.example`).
# This include is last, so its values take precedence over anything set above.
[include]
    path = config.local
