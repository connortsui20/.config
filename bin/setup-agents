#!/bin/sh

set -eu

config_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
dry_run=false
case ${1-} in
    --dry-run) dry_run=true ;;
    '') ;;
    *) printf 'Usage: %s [--dry-run]\n' "$0" >&2; exit 1 ;;
esac

# Relative skill links require this repository at ~/.config and the skills at ~/projects/skills.
if ! [ "$config_dir" -ef "$HOME/.config" ]; then
    printf 'Run this script from the repository at ~/.config.\n' >&2
    exit 1
fi
found_skill=false
for skill in "$config_dir"/agents/skills/*; do
    if [ -L "$skill" ] && [ ! -e "$skill" ]; then
        printf 'Broken link: %s. Update ~/projects/skills and its submodules.\n' "$skill" >&2
        exit 1
    fi
    if [ -f "$skill/SKILL.md" ]; then
        found_skill=true
    fi
done
if [ "$found_skill" = false ]; then
    printf 'No skills found. Check out the skills repository at ~/projects/skills.\n' >&2
    exit 1
fi

backup_legacy_skills() {
    for name in gh-stack slidev; do
        legacy="$config_dir/codex/skills/$name"
        saved="$config_dir/agents/installed-skills.before-repo/codex-$name"
        if [ ! -e "$legacy" ] && [ ! -L "$legacy" ]; then
            continue
        fi
        if [ ! -s "$config_dir/agents/skills/$name/SKILL.md" ]; then
            printf 'Missing shared skill: %s. Keeping the old copy.\n' "$name" >&2
            exit 1
        fi
        if [ -e "$saved" ] || [ -L "$saved" ]; then
            printf 'Backup already exists: %s. Keeping %s.\n' "$saved" "$legacy" >&2
            exit 1
        fi
        printf 'Move %s to %s\n' "$legacy" "$saved"
        if [ "$dry_run" = false ]; then
            mkdir -p "$(dirname -- "$saved")"
            mv "$legacy" "$saved"
        fi
    done
}

destination="$HOME/.agents"
if [ -L "$destination" ] && [ "$destination" -ef "$config_dir/agents" ]; then
    printf '~/.agents already links to ~/.config/agents.\n'
    backup_legacy_skills
    exit 0
fi

backup="$config_dir/agents.before-config"
backed_up=false
if [ -e "$destination" ] || [ -L "$destination" ]; then
    if [ -e "$backup" ] || [ -L "$backup" ]; then
        printf 'Backup already exists: %s. Move it before running setup again.\n' "$backup" >&2
        exit 1
    fi
    printf 'Move %s to %s\n' "$destination" "$backup"
    if [ "$dry_run" = false ]; then
        mv "$destination" "$backup"
        backed_up=true
    fi
fi

printf 'Link %s -> .config/agents\n' "$destination"
if [ "$dry_run" = false ]; then
    if ! ln -s .config/agents "$destination"; then
        if [ "$backed_up" = true ]; then
            mv "$backup" "$destination"
            printf 'Link creation failed. Restored %s.\n' "$destination" >&2
        fi
        exit 1
    fi
fi
backup_legacy_skills
