#!/bin/sh

set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
alacritty_dir="$config_home/alacritty"
active_theme="$alacritty_dir/active-theme.toml"

color_scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)
case $color_scheme in
    *[Dd]ark*) theme=tokyo_night_enhanced ;;
    *)         theme=tokyo_night_light ;;
esac

source_theme="$alacritty_dir/alacritty-theme/themes/$theme.toml"
if cmp -s "$source_theme" "$active_theme"; then
    exit 0
fi

# Replace the generated file atomically, then touch the root config so Alacritty reliably notices
# the change even when the imported file did not exist when the process started.
temporary_theme="$active_theme.tmp"
trap 'rm -f "$temporary_theme"' EXIT HUP INT TERM
cp "$source_theme" "$temporary_theme"
mv "$temporary_theme" "$active_theme"
touch "$alacritty_dir/alacritty.toml"
trap - EXIT HUP INT TERM
